<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aman — Personal Assistant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1E2A38;
    --ink-soft:#3C4A5C;
    --paper:#F7F3EA;
    --paper-line:#E2D9C4;
    --accent:#2F6F62;
    --accent-soft:#E4EEEA;
    --amber:#B9792F;
    --rail:#182430;
    --rail-text:#EDE6D6;
    --danger:#A6432F;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    background:var(--ink);
    color:var(--ink);
    display:flex;
    overflow:hidden;
  }

  /* Left rail */
  .rail{
    width:64px;
    min-width:64px;
    background:var(--rail);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:space-between;
    padding:20px 0;
  }
  .rail-brand{
    writing-mode:vertical-rl;
    text-orientation:mixed;
    font-family:'Fraunces',serif;
    font-size:14px;
    letter-spacing:0.04em;
    color:var(--rail-text);
    font-weight:600;
  }
  .rail-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--amber);
  }

  /* Main */
  .app{
    flex:1;
    display:flex;
    flex-direction:column;
    background:var(--paper);
    height:100vh;
  }
  header{
    padding:22px 32px 16px;
    border-bottom:1px solid var(--paper-line);
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    flex-shrink:0;
  }
  header h1{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:22px;
    margin:0;
    color:var(--ink);
  }
  header .sub{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--ink-soft);
    letter-spacing:0.03em;
  }

  .log{
    flex:1;
    overflow-y:auto;
    padding:24px 32px 12px;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 37px,
      var(--paper-line) 38px
    );
    background-attachment:local;
  }
  .entry{
    max-width:680px;
    margin:0 auto 30px;
  }
  .entry-meta{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--amber);
    letter-spacing:0.06em;
    margin-bottom:6px;
    display:flex;
    gap:10px;
    align-items:center;
  }
  .entry-meta.user{
    color:var(--accent);
    justify-content:flex-end;
  }
  .bubble{
    padding:14px 16px;
    border-radius:3px;
    line-height:1.55;
    font-size:15px;
    white-space:pre-wrap;
  }
  .bubble.assistant{
    background:transparent;
    border-left:3px solid var(--amber);
    padding-left:16px;
    color:var(--ink);
  }
  .bubble.user{
    background:var(--ink);
    color:var(--paper);
    margin-left:auto;
    max-width:85%;
    border-radius:6px;
  }
  .row-user{ display:flex; }

  .bubble.error{
    border-left:3px solid var(--danger);
    color:var(--danger);
    padding-left:16px;
  }

  .typing{
    max-width:680px;
    margin:0 auto 30px;
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--ink-soft);
    display:none;
  }
  .typing.show{ display:block; }
  .dots span{
    display:inline-block;
    width:5px;height:5px;
    border-radius:50%;
    background:var(--ink-soft);
    margin-right:3px;
    animation:blink 1.2s infinite;
  }
  .dots span:nth-child(2){ animation-delay:0.2s; }
  .dots span:nth-child(3){ animation-delay:0.4s; }
  @keyframes blink{ 0%,80%,100%{opacity:0.2;} 40%{opacity:1;} }

  .chips{
    display:flex;
    gap:8px;
    padding:0 32px 12px;
    flex-wrap:wrap;
    flex-shrink:0;
  }
  .chip{
    font-family:'IBM Plex Mono',monospace;
    font-size:11.5px;
    color:var(--ink-soft);
    background:var(--accent-soft);
    border:1px solid transparent;
    padding:6px 11px;
    border-radius:14px;
    cursor:pointer;
    transition:border-color 0.15s;
  }
  .chip:hover{ border-color:var(--accent); color:var(--accent); }

  .composer{
    flex-shrink:0;
    padding:16px 32px 24px;
    background:var(--paper);
  }
  .composer-inner{
    max-width:680px;
    margin:0 auto;
    display:flex;
    align-items:flex-end;
    gap:10px;
    background:#fff;
    border:1px solid var(--paper-line);
    border-radius:10px;
    padding:8px 8px 8px 16px;
    box-shadow:0 2px 10px rgba(30,42,56,0.06);
  }
  textarea{
    flex:1;
    border:none;
    outline:none;
    resize:none;
    font-family:'Inter',sans-serif;
    font-size:15px;
    line-height:1.5;
    max-height:140px;
    padding:8px 0;
    background:transparent;
    color:var(--ink);
  }
  textarea::placeholder{ color:#A8A196; }
  button.send{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    letter-spacing:0.04em;
    background:var(--ink);
    color:var(--paper);
    border:none;
    border-radius:7px;
    padding:12px 18px;
    cursor:pointer;
    flex-shrink:0;
    transition:background 0.15s;
  }
  button.send:hover:not(:disabled){ background:var(--accent); }
  button.send:disabled{ opacity:0.4; cursor:default; }

  .hint{
    max-width:680px;
    margin:8px auto 0;
    font-family:'IBM Plex Mono',monospace;
    font-size:10.5px;
    color:#A8A196;
    text-align:right;
  }

  .log::-webkit-scrollbar{ width:8px; }
  .log::-webkit-scrollbar-thumb{ background:var(--paper-line); border-radius:4px; }

  @media (max-width:600px){
    .rail{ display:none; }
    header, .log, .chips, .composer{ padding-left:16px; padding-right:16px; }
  }
</style>
</head>
<body>

<div class="rail">
  <div class="rail-brand">AMAN</div>
  <div class="rail-dot"></div>
</div>

<div class="app">
  <header>
    <h1>Aman</h1>
    <div class="sub" id="entryCounter">LOG · ENTRY 000</div>
  </header>

  <div class="chips" id="chips">
    <div class="chip" data-prompt="Help me draft a short, clear email about: ">Draft an email</div>
    <div class="chip" data-prompt="Summarize the following in 3 bullet points: ">Summarize</div>
    <div class="chip" data-prompt="Help me break this task into steps: ">Plan a task</div>
    <div class="chip" data-prompt="Brainstorm 5 ideas for: ">Brainstorm</div>
  </div>

  <div class="log" id="log">
    <div class="entry">
      <div class="entry-meta">ENTRY 000 · <span id="introTime"></span></div>
      <div class="bubble assistant">Hi — I'm Aman, your assistant. Ask me to draft something, plan a task, think through a decision, or just talk through what's on your plate today.</div>
    </div>
    <div class="typing" id="typing"><span class="dots"><span></span><span></span><span></span></span> thinking</div>
  </div>

  <div class="composer">
    <div class="composer-inner">
      <textarea id="input" rows="1" placeholder="Ask Aman anything..."></textarea>
      <button class="send" id="sendBtn">SEND ↵</button>
    </div>
    <div class="hint">Enter to send · Shift+Enter for new line</div>
  </div>
</div>

<script>
  const log = document.getElementById('log');
  const input = document.getElementById('input');
  const sendBtn = document.getElementById('sendBtn');
  const typing = document.getElementById('typing');
  const entryCounter = document.getElementById('entryCounter');
  const chips = document.getElementById('chips');

  document.getElementById('introTime').textContent = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});

  let history = [];
  let entryNum = 0;

  function timeNow(){
    return new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
  }

  function pad(n){ return String(n).padStart(3,'0'); }

  function addEntry(role, text, isError=false){
    entryNum++;
    entryCounter.textContent = `LOG · ENTRY ${pad(entryNum)}`;
    const entry = document.createElement('div');
    entry.className = 'entry';
    if(role === 'user'){
      entry.innerHTML = `
        <div class="entry-meta user">ENTRY ${pad(entryNum)} · ${timeNow()}</div>
        <div class="row-user"><div class="bubble user"></div></div>
      `;
      entry.querySelector('.bubble').textContent = text;
    } else {
      entry.innerHTML = `
        <div class="entry-meta">ENTRY ${pad(entryNum)} · ${timeNow()}</div>
        <div class="bubble ${isError ? 'error' : 'assistant'}"></div>
      `;
      entry.querySelector('.bubble').textContent = text;
    }
    log.insertBefore(entry, typing);
    log.scrollTop = log.scrollHeight;
    return entry;
  }

  function autosize(){
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 140) + 'px';
  }
  input.addEventListener('input', autosize);

  input.addEventListener('keydown', (e) => {
    if(e.key === 'Enter' && !e.shiftKey){
      e.preventDefault();
      sendMessage();
    }
  });

  sendBtn.addEventListener('click', sendMessage);

  chips.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if(!chip) return;
    input.value = chip.dataset.prompt;
    input.focus();
    autosize();
    input.setSelectionRange(input.value.length, input.value.length);
  });

  async function sendMessage(){
    const text = input.value.trim();
    if(!text) return;

    addEntry('user', text);
    history.push({ role: 'user', content: text });
    input.value = '';
    autosize();

    sendBtn.disabled = true;
    typing.classList.add('show');
    log.scrollTop = log.scrollHeight;

    try{
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 1000,
          system: "You are Aman, a warm, direct, highly capable personal assistant. Help the user plan tasks, draft writing, think through decisions, and stay organized. Be concise and practical by default; expand only when the task calls for it.",
          messages: history
        })
      });

      if(!response.ok){
        throw new Error(`API error ${response.status}`);
      }

      const data = await response.json();
      const replyText = (data.content || [])
        .map(block => block.type === 'text' ? block.text : '')
        .filter(Boolean)
        .join('\n')
        .trim() || "(No response returned.)";

      typing.classList.remove('show');
      addEntry('assistant', replyText);
      history.push({ role: 'assistant', content: replyText });

    } catch(err){
      typing.classList.remove('show');
      addEntry('assistant', `Something went wrong reaching the assistant: ${err.message}. Try again in a moment.`, true);
      console.error('Aman error:', err);
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  }
</script>

</body>
</html>
